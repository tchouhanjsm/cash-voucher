      "method": "POST",
      "path": "/vouchers",
      "access": "create; bulk additionally requires bulk",
      "kind": "write",
      "state": "implemented",
      "serverState": "implemented",
      "clientState": "implemented",
      "adapterAction": "createVouchers",
      "capabilities": {
        "singleEntry": "implemented",
        "bulkImport": "implemented",
        "bulkImportPath": "/imports/vouchers",
        "sourceIdentity": "sourceRecordId"
      },
      "notes": "Single entry and bounded 100-row source-identified batches are mapped. Batch and row ledgers support idempotent replay, conflict quarantine and paise reconciliation. Historical number, approval/cancellation and private receipt states are quarantined rather than overwritten."
