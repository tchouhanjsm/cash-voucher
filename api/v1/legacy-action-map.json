  "shadowResources": {
    "entrySuggestions": {
      "method": "GET",
      "path": "/entry-suggestions",
      "access": "authenticated; creator/property scoped",
      "kind": "advisory-read",
      "state": "implemented",
      "serverState": "implemented",
      "clientState": "implemented",
      "adapterAction": "entrySuggestions",
      "notes": "Hints are advisory and require an explicit employee selection."
    },
    "voucherImport": {
      "method": "POST",
      "path": "/imports/vouchers",
      "access": "manager or owner; create and bulk capabilities",
      "kind": "idempotent-financial-import",
      "state": "implemented",
      "serverState": "implemented",
      "clientState": "implemented",
      "adapterAction": "createVouchers",
      "sourceIdentity": "sourceSystem:sourceRecordId",
      "batchIdentity": "sourceSystem:batchId+canonical row manifest SHA-256",
      "maxRows": 100,
      "notes": "Imports active/new-entry-shaped vouchers. Legacy statuses, original numbering and receipt references are quarantined for separate historical migration. Apps Script remains production authority."
    }
  },
  "fieldContracts": {
    "createVouchers": {
      "requiredEntryFields": [
        "sourceRecordId",
        "date",
        "vendor",
        "amount",
        "type",
        "cashImpact",
        "clientId"
      ],
      "optionalEntryFields": [
        "vendorId",
        "category",
        "notes",
        "paymentMethod",
        "duplicateConfirmationToken",
        "sourceStatus",
        "sourceApprovalStatus",
        "sourceVoucherNo",
        "sourceReceipts",
        "sourceVendorType"
      ],
      "responseFields": [
        "batchId",
        "status",
        "rows",
        "reconciliation.rowCount",
        "reconciliation.importedCount",
        "reconciliation.replayedCount",
        "reconciliation.quarantinedCount",
        "reconciliation.pendingCount",
        "reconciliation.variancePaise",
        "reconciliation.balanced"
      ],
      "guarantees": [
        "stable source ID",
        "stable batch retry identity",
        "source row hash",
        "unique source_legacy_id",
        "transactional voucher plus audit event",
        "explicit quarantine",
        "paise-based reconciliation"
      ],
      "notes": "Per-row outcomes preserve source identifiers. Rows with non-importable historical state are never flattened into the active-entry payload."
    },
    "voucherHistory": {
      "requestFields": [
        "id",
        "cursor",
        "limit",
        "eventCategory"
      ],
      "responseFields": [
        "source",
        "voucher",
        "items[].id",
        "items[].eventType",
        "items[].targetId",
        "items[].before",
        "items[].after",
        "items[].reason",
        "items[].occurredAtUtc",
        "nextCursor",
        "hasMore"
      ],
      "exportFields": [
        "sourceSystem",
        "sourceScope",
        "coverageStatement",
        "eventId",
        "occurredAtUtc",
        "actorEmail",
        "eventType",
        "targetId",
        "beforeJson",
        "afterJson"
      ],
      "notes": "The structured SQL export does not fabricate spreadsheet row numbers or claim historical spreadsheet coverage."
    },
    "checkVoucherDuplicates": {
      "requestFields": [
        "entries[].clientId",
        "entries[].date",
        "entries[].vendor",
        "entries[].amount",
        "entries[].type",
        "entries[].cashImpact",
        "entries[].paymentMethod"
      ],
      "responseFields": [
        "results[].index",
        "results[].clientId",
        "results[].duplicateCount",
        "results[].hiddenCount",
        "results[].confirmationToken"
      ]
    }
  }
