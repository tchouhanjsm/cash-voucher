APP_NAME="Cash Voucher Laravel API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Local/test database only. Point this at a disposable database that already has
# the root database/migrations 0001-0004 applied. Do not use production credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cash_voucher_laravel_local
DB_USERNAME=cash_voucher_laravel_app
DB_PASSWORD=replace-with-local-test-secret

# Generate an independent local value of at least 32 characters.
CV_DUPLICATE_CONFIRMATION_KEY=replace-with-32-character-local-test-secret
