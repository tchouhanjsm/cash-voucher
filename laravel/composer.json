{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "cash-voucher/laravel-api",
  "type": "project",
  "description": "Isolated Laravel 13 API runtime for Cash Voucher.",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.40"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "CashVoucher\\Api\\": "../api/v1/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php artisan test",
    "lint": "find app bootstrap config public routes tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
