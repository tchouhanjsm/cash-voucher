{
  "name": "cash-voucher-v2",
  "private": true,
  "version": "2.0.0",
  "description": "Cash voucher web application with Google Apps Script backend.",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "test": "node test/test-backend.js && node test/test-dependency-audit.js && node test/test-pr-quality.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:json": "node scripts/validate-json.js",
    "check:syntax": "node scripts/check-js.js",
    "inspect:frontend": "node scripts/inspect-frontend.js",
    "check": "npm run lint && npm run format:check && npm run validate:json && npm run check:syntax && npm run check:frontend && npm test",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fix": "npm run fix:format && npm run fix:lint && npm run check",
    "ship": "node scripts/ship.js",
    "status": "clasp status",
    "push": "clasp push",
    "watch": "clasp push --watch",
    "open": "clasp open",
    "release": "node scripts/release.js",
    "check:frontend": "node scripts/verify-frontend-release.js",
    "check:pr-quality": "node scripts/check-pr-quality.js",
    "test:e2e": "bash test/run-e2e.sh",
    "audit:deps": "node scripts/dependency-audit.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@google/clasp": "^3.1.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
