# Local development only. This file is a template; PHP does not auto-load it.
# Set these values in your shell, process manager or hosting control panel.
CV_APP_ENV=local

CV_DB_HOST=127.0.0.1
CV_DB_PORT=3306
CV_DB_NAME=cash_voucher_local
CV_DB_USER=cash_voucher_app
CV_DB_PASSWORD=replace-with-a-local-only-secret

# A separate DDL-capable account is required only for the CLI migration command.
CV_MIGRATION_DB_USER=cash_voucher_migrator
CV_MIGRATION_DB_PASSWORD=replace-with-a-separate-local-only-secret
CV_ALLOW_SCHEMA_MIGRATIONS=false
