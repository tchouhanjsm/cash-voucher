# Local development only. This file is a template; PHP does not auto-load it.
# Set these values in your shell, process manager or hosting control panel.
CV_APP_ENV=local

CV_DB_HOST=127.0.0.1
CV_DB_PORT=3306
CV_DB_NAME=cash_voucher_local
CV_DB_USER=cash_voucher_app
CV_DB_PASSWORD=replace-with-a-local-only-secret

# A separate DDL-capable account is required only for the CLI migration command.
CV_MIGRATION_DB_USER=cash_voucher_migrator
CV_MIGRATION_DB_PASSWORD=replace-with-a-separate-local-only-secret
CV_ALLOW_SCHEMA_MIGRATIONS=false

# Required by the PHP authentication service. Generate independent random values.
CV_AUTH_RATE_LIMIT_KEY=replace-with-a-random-secret-at-least-32-characters
# Required only while verifying imported Apps Script HMAC credentials during migration.
# Inject the existing Script Property securely; never commit its value.
CV_LEGACY_PASSWORD_PEPPER=replace-with-the-existing-apps-script-pepper
# Default off. Enable temporarily only for owner-approved legacy PIN migration of must-change users.
CV_ALLOW_LEGACY_SHORT_PASSWORDS=false
