# Local development only. This file is a template; PHP does not auto-load it.
# Set these values in your shell, process manager or hosting control panel.
CV_APP_ENV=local

CV_DB_HOST=127.0.0.1
CV_DB_PORT=3306
CV_DB_NAME=cash_voucher_local
CV_DB_USER=cash_voucher_app
CV_DB_PASSWORD=replace-with-a-local-only-secret

# Random, independent secret (at least 32 bytes) for HMAC-hashing login throttle identifiers.
CV_AUTH_THROTTLE_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Optional during phased import: exact current Apps Script Script Property PEPPER.
# It is needed only while imported legacy-hmac-sha256-v1 users remain.
CV_LEGACY_AUTH_PEPPER=owner-supplied-legacy-pepper

# Leave blank by default. Set to PIN_TO_PASSWORD_V1 only for an owner-approved
# import window when users must change a short temporary PIN immediately after login.
CV_LEGACY_SHORT_CREDENTIAL_MIGRATION=

# A separate DDL-capable account is required only for the CLI migration command.
CV_MIGRATION_DB_USER=cash_voucher_migrator
CV_MIGRATION_DB_PASSWORD=replace-with-a-separate-local-only-secret
CV_ALLOW_SCHEMA_MIGRATIONS=false
