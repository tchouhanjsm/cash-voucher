#!/bin/sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "ERROR: Direct pushes to main are blocked by this local safety hook."
    echo "Push your changes to a feature/client branch and open a pull request instead."
    exit 1
  fi
done

exit 0
